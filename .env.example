# Copy this file to .env and adjust the values. Never commit the real .env file.

# General
APP_NAME=voice-agent-gateway
ENVIRONMENT=development
LOG_LEVEL=INFO
# "text" is easier to read locally; "json" is better for log aggregation in production.
LOG_FORMAT=text

# Database: SQLite by default. For Postgres use e.g.
# DATABASE_URL=postgresql+psycopg://gateway:gateway@localhost:5432/gateway
DATABASE_URL=sqlite:///./voice_gateway.db

# Comma-separated list of API keys accepted in the X-API-Key header.
API_KEYS=dev-key-1,dev-key-2

# Shared secret used to verify HMAC-SHA256 signatures on incoming webhooks.
WEBHOOK_SECRET=change-me-webhook-secret

# Token bucket rate limiting (per API key).
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=1.0

# Appointment scheduling (all times are UTC).
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=17
APPOINTMENT_SLOT_MINUTES=30

# Outbound client for the voice platform's REST API.
VOICE_PLATFORM_BASE_URL=https://api.example-voice-platform.com
VOICE_PLATFORM_API_KEY=replace-me
VOICE_PLATFORM_TIMEOUT_SECONDS=10
VOICE_PLATFORM_MAX_RETRIES=3
