# Copy this file to .env and adjust the values. Never commit the real .env file.
# Every integration below is optional: with the defaults the service runs fully offline.

# ---------- General ----------
APP_NAME=voice-ai-backend
ENVIRONMENT=development
LOG_LEVEL=INFO
# "text" is easier to read locally; "json" is better for log aggregation in production.
LOG_FORMAT=text

# ---------- Database ----------
# SQLite by default. For Postgres use e.g.
# DATABASE_URL=postgresql+psycopg://voiceai:voiceai@localhost:5432/voiceai
DATABASE_URL=sqlite:///./voice_ai_backend.db
# true: create tables at startup (handy locally). Production uses `alembic upgrade head`.
AUTO_CREATE_TABLES=true

# ---------- Security ----------
# Comma-separated list of API keys accepted in the X-API-Key header.
API_KEYS=dev-key-1,dev-key-2
# Shared secret for signatures on the generic /webhooks/voice endpoint.
WEBHOOK_SECRET=change-me-webhook-secret
# Signed webhooks older than this many seconds are rejected (replay protection).
WEBHOOK_TOLERANCE_SECONDS=300

# ---------- Rate limiting (token bucket per API key) ----------
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=1.0
# Set to share limits across several instances, e.g. redis://localhost:6379/0
REDIS_URL=

# ---------- Scheduling ----------
# IANA time zone name, e.g. America/New_York, Europe/London, Asia/Kolkata.
BUSINESS_TIMEZONE=UTC
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=17
APPOINTMENT_SLOT_MINUTES=30
# Tool responses slower than this are logged and counted in /metrics.
TOOL_LATENCY_BUDGET_MS=800

# ---------- Durable webhook processing ----------
# How often the sweeper retries unprocessed/failed events (0 disables it).
EVENT_RETRY_INTERVAL_SECONDS=30
EVENT_RETRY_MIN_AGE_SECONDS=30
EVENT_MAX_ATTEMPTS=5

# ---------- Retell AI ----------
# Your Retell API key: Retell signs webhooks and function calls with it.
RETELL_API_KEY=

# ---------- LLM call analysis (Claude) ----------
LLM_ANALYSIS_ENABLED=false
# Optional if ANTHROPIC_API_KEY is set in the environment or you used `ant auth login`.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# ---------- Google Calendar (optional) ----------
# Share the calendar with the service account's e-mail ("Make changes to events").
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# ---------- Observability ----------
METRICS_ENABLED=true
TRACING_ENABLED=false
# Standard OpenTelemetry settings, used when TRACING_ENABLED=true:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---------- Outbound voice platform client ----------
VOICE_PLATFORM_BASE_URL=https://api.example-voice-platform.com
VOICE_PLATFORM_API_KEY=replace-me
VOICE_PLATFORM_TIMEOUT_SECONDS=10
VOICE_PLATFORM_MAX_RETRIES=3
